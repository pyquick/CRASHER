# Required on first deployment. Use a unique password and rotate it after login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Replace-With-A-Unique-Strong-Password!123

# Keep true in production. Set false only for trusted localhost HTTP development.
COOKIE_SECURE=true
TRUST_PROXY=false

# Comma-separated browser origins. Leave empty for same-origin only.
CORS_ORIGINS=

# Require an admin-created API key on crash/feedback ingestion endpoints.
API_REQUIRE_KEY=true

# ── SMTP (email notifications & verification) ──
# SMTP_HOST=smtp.gmail.com          # Gmail: smtp.gmail.com (port 465, secure=true)
# SMTP_PORT=465                     # QQ: smtp.qq.com (port 465, secure=true)
# SMTP_SECURE=true                   # 163: smtp.163.com (port 465, secure=true)
# SMTP_USER=your-email@gmail.com     # Must use app password, not login password
# SMTP_PASSWORD=your-16-char-app-pw  # Generate: https://myaccount.google.com/apppasswords
# ALERT_EMAIL_FROM=your-email@gmail.com
# ALERT_EMAIL_TO=your-email@gmail.com
# ALERT_ON_NEW_GROUP=true
# ALERT_THRESHOLD_COUNT=10

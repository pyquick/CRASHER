# Admin account is created on first launch via the web setup UI (POST /api/v1/auth/setup).
# SMTP must be configured below for email verification during first login.

# Direct localhost:8080 access uses HTTP. Set true only when accessing through HTTPS.
COOKIE_SECURE=false
TRUST_PROXY=false
LOGIN_RATE_LIMIT=150

# Comma-separated browser origins. Leave empty for same-origin only.
CORS_ORIGINS=

# Require an admin-created API key on crash/feedback ingestion endpoints.
API_REQUIRE_KEY=true
AI_ENCRYPTION_KEY=
# ── SMTP (email notifications & verification) ──
SMTP_HOST=       # Gmail: smtp.gmail.com (port 465, secure=true)
SMTP_PORT=465                     # QQ: smtp.qq.com (port 465, secure=true)
SMTP_SECURE=true                   # 163: smtp.163.com (port 465, secure=true)
SMTP_USER=    # Must use app password, not login password
SMTP_PASSWORD=your-16-char-app-pw  # Generate: https://myaccount.google.com/apppasswords
ALERT_EMAIL_FROM=your-email@gmail.com
ALERT_EMAIL_TO=your-email@gmail.com
ALERT_ON_NEW_GROUP=true
ALERT_THRESHOLD_COUNT=10

# ── AI assistant (optional; admin/operator only) ──
# 32-byte hex key used to encrypt provider keys and chat history at rest.
# Keep this stable and back it up securely; changing it makes existing AI data unreadable.
AI_ENCRYPTION_KEY=
AI_DEEPSEEK_MODEL=deepseek-chat
# Optional server-side override for the DeepSeek endpoint (proxies, testing).
# Clients can never set this; defaults to https://api.deepseek.com/chat/completions.
AI_DEEPSEEK_ENDPOINT=
AI_REQUEST_TIMEOUT_MS=60000
AI_MESSAGE_MAX_LENGTH=10000
AI_CONTEXT_MAX_CHARS=120000
AI_SOURCE_MAX_FILES=20
AI_HISTORY_MAX_CHARS=40000
AI_RATE_LIMIT=20
AI_MAX_CONVERSATIONS=50
AI_MAX_MESSAGES_PER_CONVERSATION=100
AI_RETENTION_DAYS=30
